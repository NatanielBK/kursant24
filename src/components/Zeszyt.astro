---
// Sygnatura: kartka w kratkę z wpisami ołówkiem, które przewijanie przepisuje w grafik tygodnia.
// Stan ustawia moduł-sterownik src/motion/przepisz.ts (jedna zmienna p). Bez JS i pod
// reduced motion widać stan końcowy: czysty grafik.
import { wpisy, dni } from '../data/site';
const godz = [8, 10, 12, 14, 16, 18, 20];
const hh = (h: number) => `${h}:00`;
const parts = (w: (typeof wpisy)[number]) => {
  if (!w.strike) return [{ t: w.note, s: false }];
  const i = w.note.indexOf(w.strike);
  return [
    { t: w.note.slice(0, i), s: false },
    { t: w.strike, s: true },
    { t: w.note.slice(i + w.strike.length), s: false },
  ];
};
---
<div
  class="zeszyt"
  data-zeszyt
  role="img"
  aria-label="Kartka z zeszytu z sześcioma odręcznymi wpisami jazd, wykładu i egzaminu. Po przewinięciu każdy wpis trafia do swojego okienka w grafiku tygodnia, od poniedziałku do soboty."
>
  <div class="zeszyt__kratka" data-kratka></div>
  <span class="zeszyt__margines"></span>
  <div class="tydzien">
    <div class="tydzien__dni" data-dni>
      {dni.map((d) => <span>{d}</span>)}
    </div>
    <div class="tydzien__body" data-tydzien>
      <div class="tydzien__linie" data-linie></div>
      <div class="tydzien__godz" data-godz>
        {godz.map((h, i) => <span style={`--i:${i}`}>{hh(h)}</span>)}
      </div>
      <div class="teraz" data-teraz>
        <i class="teraz__dot" data-teraz-dot></i>
        <span class="teraz__label" data-teraz-label>teraz</span>
      </div>
      {wpisy.map((w) => (
        <div
          class:list={['wpis', `wpis--${w.kind}`]}
          data-wpis
          data-x={w.x}
          data-y={w.y}
          data-r={w.r}
          style={`--d:${w.day};--s:${w.start - 8};--l:${w.len}`}
        >
          <div class="wpis__blok">
            <span class="wpis__czas">{hh(w.start)}</span>
            <span class="wpis__tytul">{w.title}</span>
            <span class="wpis__kto">{w.who}</span>
          </div>
          <p class="wpis__olowek">
            {parts(w).map((p) => (p.s ? <s>{p.t}</s> : p.t))}
          </p>
        </div>
      ))}
    </div>
  </div>
</div>
