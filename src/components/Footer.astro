---
import { footer, nav, cta, site, credits } from '../data/content';
import Logo from './Logo.astro';
---
<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <a href="/" aria-label="kursant24, strona główna"><Logo class="logo--light" /></a>
      <p>{footer.line}</p>
    </div>
    <nav class="site-footer__nav" aria-label="Stopka">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href={cta.href}>Pilotaż</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </nav>
    <div class="site-footer__meta">
      <p>{footer.status}</p>
      <p>{footer.copy}</p>
    </div>
  </div>
  <div class="wrap site-footer__credits">
    <p>
      {credits.label}: <strong>{credits.org}</strong>
      {credits.items.map((c) => (
        <>
          {' · '}
          {c.name}, tel. <a href={`tel:+48${c.phone.replace(/\s/g, '')}`}>{c.phone}</a>,{' '}
          <a href={`mailto:${c.email}`}>{c.email}</a>
        </>
      ))}
    </p>
  </div>
</footer>
