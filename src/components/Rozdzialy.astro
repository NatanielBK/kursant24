---
// Rozdziały: tekst przewija się po lewej, zrzut w lepkiej scenie po prawej zmienia się z rozdziałem
// (pinned chapters z motion.md). Na telefonie każdy rozdział ma własny zrzut pod tekstem.
import Shot from './Shot.astro';
type Item = { kicker?: string; t?: string; title: string; text: string; shot: string; alt: string; frame?: 'laptop' | 'phone' | 'paper'; note?: string };
interface Props { id: string; label: string; h2: string; items: Item[]; variant?: 'rozdzialy' | 'dzien' }
const { id, label, h2, items, variant = 'rozdzialy' } = Astro.props;
const dzien = variant === 'dzien';
const kind = (it: Item) => it.frame ?? (it.shot.endsWith('-tel') ? 'phone' : it.shot === 'karta' ? 'paper' : 'laptop');
---
<section class:list={['rozdzialy', `rozdzialy--${variant}`]} id={id} aria-labelledby={`${id}-h`}>
  <div class="wrap">
    <header class="sec__head">
      <p class="eyebrow" data-reveal="fade">{label}</p>
      <h2 id={`${id}-h`} class="h-xl" data-split="lines">{h2}</h2>
    </header>
    <div class="rozdzialy__grid">
      <div class="rozdzialy__kol">
      {dzien && <div class="rozdzialy__os" aria-hidden="true"><i data-postep></i></div>}
      <ol class="rozdzialy__lista">
        {items.map((it, i) => (
          <li class="rozdzial" data-chapter>
            <p class:list={['rozdzial__nr', { 'rozdzial__nr--czas': dzien }]}>
              {dzien ? <time>{it.t}</time> : String(i + 1).padStart(2, '0')}
            </p>
            <div class="rozdzial__tekst">
              {it.kicker && <p class="rozdzial__kicker">{it.kicker}</p>}
              <h3 class="h-l">{it.title}</h3>
              <p>{it.text}</p>
            </div>
            <div class="rozdzial__media">
              {it.note && <p class="dopisek-r hand" aria-hidden="true"><span class="dopisek-r__t">{it.note}</span></p>}
              <Shot name={it.shot} alt={it.alt} frame={it.frame} />
            </div>
          </li>
        ))}
      </ol>
      </div>
      <div class="rozdzialy__scena" data-stage data-state="0">
        {items.map((it, i) => (
          <div class:list={['scena__shot', `scena__shot--${kind(it)}`, { 'is-on': i === 0 }]}>
            {/* Kopia dopisku z wersji telefonicznej: z atrybutu, żeby tekst nie dublował się w treści. */}
            {it.note && <p class="dopisek-r dopisek-r--kopia hand" aria-hidden="true"><span class="dopisek-r__t" data-note={it.note}></span></p>}
            <Shot name={it.shot} alt={it.alt} frame={it.frame} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
