---
interface Item { q: string; a: string }
interface Props { id?: string; eyebrow: string; h2: string; items: Item[] }
const { id, eyebrow, h2, items } = Astro.props;
---
<section class="section section--bg" id={id} aria-labelledby={id ? `${id}-h` : undefined}>
  <div class="wrap">
    <header class="section__head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={id ? `${id}-h` : undefined} class="h-l">{h2}</h2>
    </header>
    <div class="faq-card">
      <div class="faq-list">
        {items.map((it, i) => (
          <details class="faq-item" name={`faq-${id ?? 'x'}`} open={i === 0}>
            <summary>{it.q}</summary>
            <p>{it.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
