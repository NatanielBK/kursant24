---
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'light';
  size?: 's' | 'm';
  type?: 'submit' | 'button';
  class?: string;
  current?: boolean;
}
const { href, variant = 'primary', size = 'm', type = 'button', class: cls, current } = Astro.props;
const classes = ['btn', `btn--${variant}`, size === 's' && 'btn--s', cls];
---
{href ? (
  <a class:list={classes} href={href} aria-current={current ? 'page' : undefined}><slot /></a>
) : (
  <button class:list={classes} type={type}><slot /></button>
)}
