---
// Mapa szkół jazdy z OpenStreetMap (ODbL), kropki wygenerowane przy budowaniu (scripts/mapa.mjs).
import mapa from '../data/mapa.json';
interface Props { label: string; h2: string; text: string; attribution: string }
const { label, h2, text, attribution } = Astro.props;
const d = (mapa.punkty as [number, number][]).map(([x, y]) => `M${x} ${y}h0`).join('');
---
<section class="mapa" id="mapa" aria-labelledby="mapa-h">
  <div class="wrap mapa__grid">
    <div class="mapa__tekst">
      <p class="eyebrow eyebrow--deep" data-reveal="fade">{label}</p>
      <h2 id="mapa-h" class="h-xl" data-split="lines">{h2}</h2>
      <p class="mapa__liczba" data-reveal="up"><strong>{mapa.liczba}</strong> <span>punktów oznaczonych w OpenStreetMap jako szkoła jazdy</span></p>
      <p class="mapa__opis" data-reveal="up" data-delay="0.08">{text}</p>
      <p class="mapa__atrybucja"><a href="https://www.openstreetmap.org/copyright" rel="noopener">{attribution}</a></p>
    </div>
    <figure class="mapa__fig" data-reveal="clip">
      <div class="mapa__plotno">
        <img src="/mapa-wojewodztwa.svg" alt="" width="1000" height="946" loading="lazy" decoding="async" />
        <svg viewBox={`0 0 ${mapa.w} ${mapa.h}`} role="img" aria-label={`Mapa Polski z granicami województw i ${mapa.liczba} punktami szkół jazdy z OpenStreetMap, najgęściej wokół dużych miast.`}>
          <path d={d} fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" />
        </svg>
      </div>
    </figure>
  </div>
</section>
