---
// Kod aktywacyjny jako jedna wielka linia: znaki wpinają się w kratki jak w polu logowania.
interface Props { code: string; small?: boolean; label?: string }
const { code, small = false, label = 'Przykładowy kod aktywacyjny' } = Astro.props;
---
<p class:list={['kod', { 'kod--s': small }]} data-kod>
  <span class="sr-only">{label}: {code}</span>
  <span class="kod__cele" aria-hidden="true">
    {[...code].map((c) => (c === '-' ? <span class="kod__kreska">-</span> : <span class="kod__c"><span>{c}</span></span>))}
  </span>
</p>
