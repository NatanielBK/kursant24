---
// Prawdziwy zrzut aplikacji w ramce: laptop, telefon albo kartka (PDF).
import { Image, getImage } from 'astro:assets';
import { shots } from '../data/zrzuty';

interface Props {
  name: string;
  alt: string;
  frame?: 'laptop' | 'phone' | 'paper';
  sizes?: string;
  eager?: boolean;
  class?: string;
  /** Osobny zrzut/kadr na telefon (<640px), np. kadr z desktopowego zrzutu albo wersja -tel.
   * Bez tego propu komponent działa jak wcześniej (jeden zrzut na wszystkich szerokościach).
   * Uwaga: <picture> ma jeden wspólny <img alt>, więc `alt` opisuj tak, żeby pasował do obu wariantów. */
  mobile?: string;
  /** `sizes` dla źródła `mobile` (trafia do <source>, nie do głównego <img>). */
  mobileSizes?: string;
}
const { name, alt, frame, sizes, eager = false, class: cls, mobile, mobileSizes } = Astro.props;
const src = shots[name];
if (!src) throw new Error(`Brak zrzutu: ${name}`);
const kind = frame ?? (name.endsWith('-tel') ? 'phone' : name === 'karta' ? 'paper' : 'laptop');
const widths = kind === 'phone' ? [300, 390] : kind === 'paper' ? [480, 720, 905] : [640, 960, 1280, 1440];
const defaultSizes = kind === 'phone' ? '(max-width: 767px) 70vw, 320px' : kind === 'paper' ? '(max-width: 767px) 90vw, 480px' : '(max-width: 767px) 92vw, 760px';

// Źródło na telefon budujemy ręcznie (getImage), żeby <picture><source media="(max-width: 639px)">
// podmieniał cały obraz, nie tylko format — przeglądarka pobiera wtedy tylko jeden z dwóch plików.
let mobileSrcset: string | undefined;
if (mobile) {
  const mobileSrc = shots[mobile];
  if (!mobileSrc) throw new Error(`Brak zrzutu: ${mobile}`);
  const mobileWidths = [320, 390, 480].filter((w) => w <= mobileSrc.width);
  const built = await Promise.all(
    mobileWidths.map((w) => getImage({ src: mobileSrc, width: w, format: 'webp', quality: 82 })),
  );
  mobileSrcset = built.map((img, i) => `${img.src} ${mobileWidths[i]}w`).join(', ');
}
---
<figure class:list={['shot', `shot--${kind}`, mobile && 'shot--has-mobile', cls]}>
  <div class="shot__frame">
    {kind === 'laptop' && <div class="shot__bar" aria-hidden="true"><i></i><i></i><i></i></div>}
    <div class="shot__screen">
      <picture>
        {mobileSrcset && (
          <source media="(max-width: 639px)" srcset={mobileSrcset} sizes={mobileSizes ?? '88vw'} />
        )}
        <Image
          src={src}
          alt={alt}
          widths={widths.filter((w) => w <= src.width)}
          sizes={sizes ?? defaultSizes}
          format="webp"
          quality={82}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={eager ? 'high' : undefined}
        />
      </picture>
    </div>
  </div>
</figure>
