---
import { getImage, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import Faq from '../components/Faq.astro';
import { dlaSzkol as p, cennikCta } from '../data/content';
import { hero, benefits, ctaBand } from '../data/dla-szkol';
import { shots } from '../data/zrzuty';

import heroKadr from '../assets/zrzuty/kadry/b-hero-stats.png';
import grafikKadr from '../assets/zrzuty/kadry/b-grafik-kadr.png';
import ulozKadr from '../assets/zrzuty/kadry/b-uloz-kadr.png';
import kursanciKadr from '../assets/zrzuty/kadry/b-kursanci-kadr.png';
import kartaKadr from '../assets/zrzuty/kadry/b-karta-kadr.png';

const kadry: Record<string, ImageMetadata> = {
  grafik: grafikKadr,
  uloz: ulozKadr,
  kursanci: kursanciKadr,
  karta: kartaKadr,
};

// Hero jest LCP tej podstrony. Na telefonie pokazujemy czytelny kadr (dwa kafelki z liczbami),
// na komputerze pełny zrzut pulpitu — <picture> ładuje tylko jeden z nich, nie oba naraz.
const heroDesktop = await getImage({ src: shots[hero.shotLaptop], format: 'webp', quality: 82, width: 640 });
const heroMobile = await getImage({ src: heroKadr, format: 'webp', quality: 85 });
---
<Base title={p.title} description={p.description}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroMobile.src} media="(max-width: 899px)" fetchpriority="high" />
    <link rel="preload" as="image" href={heroDesktop.src} media="(min-width: 900px)" fetchpriority="high" />
  </Fragment>

  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap hero__grid">
      <div class="hero__copy enter">
        <p class="eyebrow eyebrow--light">{p.eyebrow}</p>
        <h1 id="hero-h" class="h-xl">{p.h1}</h1>
        <p class="lead">{p.lead}</p>
        <div class="btn-row">
          <Btn href="/pilotaz/">Umów prezentację</Btn>
          <Btn href="#cennik" variant="ghost">Cennik</Btn>
        </div>
      </div>
      <div class="hero-visual enter enter--delay">
        <picture class="hero-visual__pic">
          <source media="(min-width: 900px)" srcset={heroDesktop.src} />
          <img
            src={heroMobile.src}
            width={heroKadr.width}
            height={heroKadr.height}
            alt={hero.altVisual}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    </div>
  </section>

  <section class="section section--bg" aria-labelledby="dzien-h">
    <div class="wrap">
      <header class="section__head">
        <p class="eyebrow">Twój dzień z kursant24</p>
        <h2 id="dzien-h" class="h-l">Od kawy do telefonu, który nie dzwoni</h2>
      </header>
    </div>
    <ol class="day-scroll" tabindex="0" aria-label="Oś dnia właściciela, przewijana w poziomie">
      {p.day.map((d) => (
        <li class="day-card">
          <span class="day-card__time">{d.t}</span>
          <h3>{d.title}</h3>
          <p>{d.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" aria-labelledby="benefits-h">
    <div class="wrap">
      <header class="section__head">
        <p class="eyebrow">{benefits.eyebrow}</p>
        <h2 id="benefits-h" class="h-l">{benefits.h2}</h2>
      </header>
    </div>
    <ul class="carousel" tabindex="0" aria-label="Zrzuty ekranów aplikacji, przewijane w poziomie">
      {benefits.items.map((b) => (
        <li class="carousel__item">
          <article class="bcard">
            <div class="bcard__media">
              <Image src={kadry[b.kadr]} alt={b.alt} widths={[320, 480, 560]} sizes="(max-width: 699px) 78vw, (max-width: 1099px) 40vw, 260px" />
            </div>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </article>
        </li>
      ))}
    </ul>
  </section>

  <section class="section section--bg" id="cennik" aria-labelledby="cennik-h">
    <div class="wrap cennik-merge">
      <div class="cennik-merge__pricing">
        <p class="eyebrow">{cennikCta.eyebrow}</p>
        <h2 id="cennik-h" class="h-l">{cennikCta.h2}</h2>
        <p class="lead">{cennikCta.text}</p>
        <div class="btn-row">
          <Btn href={cennikCta.primary.href}>{cennikCta.primary.label}</Btn>
          <a class="link" href={cennikCta.secondary.href}>{cennikCta.secondary.label}</a>
        </div>
      </div>
      <div class="cennik-merge__divider" aria-hidden="true"></div>
      <div class="cennik-merge__migration">
        <h2 class="h-m">{p.migration.h2}</h2>
        <p>{p.migration.text}</p>
      </div>
    </div>
  </section>

  <Faq id="pytania" eyebrow="Pytania właścicieli" h2="Co jeszcze warto wiedzieć" items={p.faq} />

  <section class="cta-band" aria-labelledby="ctaband-h">
    <div class="wrap cta-band__inner">
      <p class="eyebrow eyebrow--light">{ctaBand.eyebrow}</p>
      <h2 id="ctaband-h" class="h-l">{ctaBand.h2}</h2>
      <p>{ctaBand.text}</p>
      <div class="btn-row">
        <Btn href={ctaBand.primary.href} variant="light">{ctaBand.primary.label}</Btn>
        <a class="link" style="color:#fff" href={ctaBand.secondary.href}>{ctaBand.secondary.label}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO VISUAL — jeden <picture>, jedno żądanie sieciowe: telefon dostaje czytelny kadr
     (dwa kafelki z liczbami), komputer pełny zrzut pulpitu. Bez ramki laptopa na telefonie —
     to ona robiła z pełnego zrzutu nieczytelną miniaturę. */
  .hero-visual__pic {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: 0 24px 54px -24px rgba(2, 6, 20, 0.55);
    aspect-ratio: 325 / 93;
  }
  .hero-visual__pic img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (min-width: 900px) {
    .hero-visual__pic { aspect-ratio: 640 / 400; box-shadow: var(--shadow-deep); }
  }

  /* OŚ "Twój dzień": zwarte karty w poziomej karuzeli (scroll-snap, bez JS), z wystającą
     kolejną kartą. Bez miniatur zrzutów — te były nieczytelne przy tak małej szerokości. */
  .day-scroll {
    display: flex; gap: 0.9rem; overflow-x: auto; scroll-snap-type: x mandatory;
    padding-inline: var(--gutter); scroll-padding-inline: var(--gutter);
  }
  .day-scroll::-webkit-scrollbar { display: none; }
  .day-scroll { scrollbar-width: none; }
  .day-card {
    scroll-snap-align: start; flex: 0 0 72%; max-width: 260px;
    padding: 1.1rem 1.2rem; border-radius: var(--radius-s);
    border: 1px solid var(--c-line-strong); background: var(--c-bg); box-shadow: var(--shadow-card);
  }
  .day-card__time {
    display: inline-block; font-weight: 800; color: var(--c-accent); font-size: var(--t-s);
    padding: 0.2em 0.65em; border-radius: 999px; background: var(--c-accent-soft);
  }
  .day-card h3 { font-size: var(--t-s); margin: 0.6rem 0 0.3rem; }
  .day-card p { font-size: 0.95rem; color: var(--c-muted); line-height: 1.42; }
  @media (min-width: 860px) {
    .day-scroll {
      overflow-x: visible; display: grid; grid-template-columns: repeat(4, 1fr);
      max-width: var(--max); margin-inline: auto; gap: 1.25rem; position: relative;
    }
    .day-scroll::before {
      content: ''; position: absolute; top: 1.3rem; left: 5%; right: 5%; height: 2px;
      background: var(--c-line-strong); z-index: 0;
    }
    .day-card { flex: initial; max-width: none; position: relative; z-index: 1; }
  }

  /* KORZYŚCI — karuzela zamiast dwóch osobnych sekcji (ciemnej + jasnej) z 4 jednakowymi
     kartami. Jeden, spójny styl karty, każda z innym kadrem — bez powtórzeń zrzutów. */
  .carousel {
    display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory;
    padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); list-style: none;
  }
  .carousel::-webkit-scrollbar { display: none; }
  .carousel { scrollbar-width: none; }
  .carousel__item { scroll-snap-align: start; flex: 0 0 78%; max-width: 320px; }
  .bcard {
    display: flex; flex-direction: column; gap: 0.9rem; height: 100%;
    padding: 1.1rem; border-radius: var(--radius); border: 1px solid var(--c-line);
    background: var(--c-bg); box-shadow: var(--shadow-card);
  }
  .bcard__media {
    aspect-ratio: 4 / 3; border-radius: var(--radius-s); overflow: hidden;
    background: var(--c-bg-2); display: flex; align-items: center; justify-content: center;
  }
  .bcard__media :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .bcard h3 { font-size: var(--t-m); }
  .bcard p { font-size: 0.95rem; color: var(--c-muted); line-height: 1.45; }
  @media (min-width: 700px) {
    .carousel {
      overflow-x: visible; display: grid; grid-template-columns: repeat(2, 1fr);
      max-width: var(--max); margin-inline: auto; padding-inline: var(--gutter);
    }
    .carousel__item { flex: initial; max-width: none; }
  }
  @media (min-width: 1100px) {
    .carousel { grid-template-columns: repeat(4, 1fr); }
  }

  /* CENNIK + MIGRACJA — dwie dawne sekcje w jednej, zwarcie, bez pustki między nimi. */
  .cennik-merge { display: flex; flex-direction: column; gap: 1.75rem; max-width: 40rem; margin-inline: auto; text-align: center; }
  .cennik-merge__pricing .lead { margin: 0.6rem auto 1.4rem; }
  .cennik-merge__pricing .btn-row, .cennik-merge__pricing .eyebrow { justify-content: center; }
  .cennik-merge__divider { height: 1px; background: var(--c-line-strong); }
  .cennik-merge__migration h2 { margin-bottom: 0.5rem; }
  .cennik-merge__migration p { color: var(--c-muted); font-size: 0.95rem; }
  @media (min-width: 860px) {
    .cennik-merge { flex-direction: row; align-items: center; text-align: left; max-width: var(--max); gap: 3rem; }
    .cennik-merge__pricing, .cennik-merge__migration { flex: 1; }
    .cennik-merge__pricing .btn-row, .cennik-merge__pricing .eyebrow { justify-content: flex-start; }
    .cennik-merge__divider { width: 1px; height: auto; align-self: stretch; }
  }
</style>
