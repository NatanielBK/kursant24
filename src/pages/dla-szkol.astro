---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import Shot from '../components/Shot.astro';
import Faq from '../components/Faq.astro';
import { dlaSzkol as p, cennikCta } from '../data/content';
---
<Base title={p.title} description={p.description}>
  <section class="podhero" aria-labelledby="podhero-h">
    <div class="wrap podhero__grid">
      <div class="podhero__copy">
        <p class="eyebrow">{p.eyebrow}</p>
        <h1 id="podhero-h" class="h-xl">{p.h1}</h1>
        <p class="lead">{p.lead}</p>
        <div class="btn-row">
          <Btn href="/pilotaz/">Umów prezentację</Btn>
          <a class="link" href="#cennik">Cennik</a>
        </div>
      </div>
      <div class="podhero__shot">
        <Shot name={p.shot.name} alt={p.shot.alt} eager />
      </div>
    </div>
  </section>

  <section class="section section--bg" aria-labelledby="dzien-h">
    <div class="wrap">
      <header class="section__head">
        <p class="eyebrow">Twój dzień z kursant24</p>
        <h2 id="dzien-h" class="h-l">Od pierwszej kawy do telefonu, który nie dzwoni</h2>
      </header>
      <div class="split">
        <div class="day-list">
          {p.day.map((d) => (
            <div class="day-item">
              <span class="day-item__t">{d.t}</span>
              <div><h3>{d.title}</h3><p>{d.text}</p></div>
            </div>
          ))}
        </div>
        <div class="split__shot">
          <Shot name="kursanci-pc" alt="Lista kursantów szkoły z postępem godzin i przypisanym instruktorem." frame="laptop" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="cennik" aria-labelledby="cennik-h">
    <div class="wrap" style="max-width:34rem; text-align:center; margin-inline:auto">
      <p class="eyebrow" style="justify-content:center">{cennikCta.eyebrow}</p>
      <h2 id="cennik-h" class="h-l">{cennikCta.h2}</h2>
      <p class="lead" style="margin:0.6rem auto 1.6rem">{cennikCta.text}</p>
      <div class="btn-row" style="justify-content:center">
        <Btn href={cennikCta.primary.href}>{cennikCta.primary.label}</Btn>
        <a class="link" href={cennikCta.secondary.href}>{cennikCta.secondary.label}</a>
      </div>
    </div>
  </section>

  <section class="section section--bg" aria-labelledby="migr-h">
    <div class="wrap">
      <h2 id="migr-h" class="h-l">{p.migration.h2}</h2>
      <p class="lead" style="margin-top:0.6rem">{p.migration.text}</p>
    </div>
  </section>

  <Faq id="pytania" eyebrow="Pytania właścicieli" h2="Co jeszcze warto wiedzieć" items={p.faq} />
</Base>
