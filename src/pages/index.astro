---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import Shot from '../components/Shot.astro';
import Faq from '../components/Faq.astro';
import { home, plans, faqHome } from '../data/content';
import { shots } from '../data/zrzuty';

// Zrzut w hero jest LCP strony głównej: preload.
const heroShot = await getImage({ src: shots[home.hero.shot], format: 'webp', quality: 82, width: 390 });
---
<Base title={home.title}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroShot.src} fetchpriority="high" />
  </Fragment>

  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">{home.hero.eyebrow}</p>
        <h1 id="hero-h" class="h-xl">{home.hero.h1}</h1>
        <p class="lead">{home.hero.lead}</p>
        <div class="btn-row">
          <Btn href="/pilotaz/">Umów prezentację</Btn>
          <a class="link" href="#funkcje">Zobacz funkcje</a>
        </div>
      </div>
      <div class="hero__shot">
        <Shot name={home.hero.shot} alt={home.hero.alt} eager />
      </div>
    </div>
  </section>

  <section class="section" id="funkcje" aria-labelledby="funkcje-h">
    <div class="wrap">
      <header class="section__head">
        <p class="eyebrow">{home.features.eyebrow}</p>
        <h2 id="funkcje-h" class="h-l">{home.features.h2}</h2>
      </header>
      <div class="features-grid">
        {home.features.items.map((f) => (
          <article class="feature-card">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--bg" aria-labelledby="role-h">
    <div class="wrap">
      <header class="section__head">
        <p class="eyebrow">{home.roles.eyebrow}</p>
        <h2 id="role-h" class="h-l">{home.roles.h2}</h2>
      </header>
      <div class="roles-grid">
        {home.roles.items.map((r) => (
          <article class="role-card">
            <h3>{r.title}</h3>
            <p>{r.text}</p>
            <ul>
              {r.points.map((pt) => <li>{pt}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="cennik" aria-labelledby="cennik-h">
    <div class="wrap">
      <div class="plans-top">
        <header class="section__head" style="margin-bottom:0">
          <p class="eyebrow">{plans.eyebrow}</p>
          <h2 id="cennik-h" class="h-l">{plans.h2}</h2>
        </header>
        <p class="plans-free">{plans.free}</p>
      </div>
      <div class="plans-grid">
        {plans.rows.map((r, i) => (
          <article class:list={['plan-card', { 'plan-card--pick': i === 1 }]}>
            {i === 1 && <span class="plan-card__pick-tag">{plans.pick}</span>}
            <h3 class="h-m">{r.name}</h3>
            <p class="plan-card__who">{r.who}</p>
            <p class="plan-card__price"><strong>{r.price} zł</strong><span>/mies.</span></p>
            <ul>
              {r.items.map((it) => <li>{it}</li>)}
            </ul>
            <Btn href={`/pilotaz/?plan=${r.name.toLowerCase()}`} variant={i === 1 ? 'primary' : 'ghost'}>Umów prezentację</Btn>
          </article>
        ))}
      </div>
      <p class="plans-note">{plans.note} {plans.soon}</p>
    </div>
  </section>

  <Faq id="pytania" eyebrow="Pytania" h2="Najczęstsze pytania" items={faqHome} />

  <section class="cta-band" aria-labelledby="ctaband-h">
    <div class="wrap cta-band__inner">
      <p class="eyebrow eyebrow--light">{home.cta.eyebrow}</p>
      <h2 id="ctaband-h" class="h-l">{home.cta.h2}</h2>
      <p>{home.cta.text}</p>
      <div class="btn-row">
        <Btn href={home.cta.primary.href} variant="light">{home.cta.primary.label}</Btn>
        <a class="link" style="color:#fff" href={home.cta.secondary.href}>{home.cta.secondary.label}</a>
      </div>
    </div>
  </section>
</Base>
