---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import Zeszyt from '../components/Zeszyt.astro';
import Rozdzialy from '../components/Rozdzialy.astro';
import Indeks from '../components/Indeks.astro';
import Kod from '../components/Kod.astro';
import Shot from '../components/Shot.astro';
import Cennik from '../components/Cennik.astro';
import MapaOSK from '../components/MapaOSK.astro';
import Faq from '../components/Faq.astro';
import { home, faqHome, wpisy } from '../data/site';
const { hero, manifest, chapters, index, kod, map } = home;
---
<Base title={home.title}>
  <section class="hero" data-hero aria-labelledby="hero-h">
    <div class="hero__stage">
      <div class="hero__copy">
        <p class="eyebrow" data-reveal="fade" data-intro>{hero.label}</p>
        <h1 id="hero-h" class="hero__h" data-split="lines" data-intro>{hero.h1}</h1>
        <p class="hero__lead">{hero.lead}</p>
        <div class="hero__cta" data-reveal="up" data-intro data-delay="0.35">
          <Btn href={hero.primary.href}>{hero.primary.label}</Btn>
          <a class="hero__more draw" href={hero.secondary.href}>{hero.secondary.label}</a>
        </div>
      </div>
      <div class="hero__kartka">
        <Zeszyt />
        <div class="hero__status" aria-hidden="true">
          <span class="hero__stan hand" data-stan>{hero.stateFrom}</span>
          <span class="pasek"><i data-pasek></i></span>
          <span class="hero__stan-do">{hero.stateTo}</span>
          <span class="hero__licznik"><span data-licznik>0</span>/{wpisy.length} przepisanych</span>
        </div>
      </div>
      <p class="hero__hint" aria-hidden="true"><span class="hero__hint-line"></span>{hero.scrollHint}</p>
    </div>
  </section>

  <section class="manifest" aria-labelledby="manifest-h">
    <div class="wrap manifest__grid">
      <h2 id="manifest-h" class="eyebrow manifest__label">{manifest.label}</h2>
      <ul class="manifest__lista">
        {manifest.lines.map((l) => (
          <li class="manifest__linia" data-skreslenie>
            <span class="manifest__tekst">{l}</span>
          </li>
        ))}
      </ul>
      <p class="manifest__odpowiedz" data-split="lines">{manifest.answer}</p>
    </div>
  </section>

  <Rozdzialy id="rozdzialy" label={chapters.label} h2={chapters.h2} items={chapters.items as any} />

  <Indeks id="wyrozniki" label={index.label} h2={index.h2} rows={index.rows} />

  <section class="kod-sec" aria-labelledby="kod-h">
    <div class="wrap">
      <p class="eyebrow" data-reveal="fade">{kod.label}</p>
      <Kod code={kod.code} />
      <div class="kod-sec__grid">
        <div>
          <h2 id="kod-h" class="h-l" data-split="lines">{kod.h2}</h2>
          <ol class="kroki">
            {kod.steps.map((s) => (
              <li class="krok" data-reveal="up">
                <span class="krok__n" aria-hidden="true">{s.n}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))}
          </ol>
          <p class="kod-sec__link"><a class="link" href="/dla-kursantow/">Jak to wygląda u kursanta</a></p>
        </div>
        <div class="kod-sec__shot" data-reveal="up">
          <Shot name={kod.shot} alt={kod.alt} />
        </div>
      </div>
    </div>
  </section>

  <Cennik id="cennik" />

  <MapaOSK label={map.label} h2={map.h2} text={map.text} attribution={map.attribution} />

  <Faq id="pytania" label="Pytania" h2="Zanim zapytasz" items={faqHome} />
</Base>
