---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import Shot from '../components/Shot.astro';
import Kod from '../components/Kod.astro';
import Cennik from '../components/Cennik.astro';
import MapaOSK from '../components/MapaOSK.astro';
import Faq from '../components/Faq.astro';
import { shots } from '../data/zrzuty';
import { home, faqHome } from '../data/site';
import '../styles/glowna.css';

const { hero, roles, chapters, index, kod, map } = home;

const bento = await Promise.all(
  index.rows.map(async (r) => {
    const src = shots[r.shot];
    const tall = src.height > src.width;
    const img = await getImage({ src, width: tall ? 420 : 720, format: 'webp', quality: 76 });
    return { url: img.src, tall };
  }),
);
---
<Base title={home.title}>
  <section class="hero2" data-hero2 aria-labelledby="hero-h">
    <div class="wrap hero2__wrap">
      <div class="hero2__copy">
        <p class="eyebrow" data-reveal="fade" data-intro>{hero.label}</p>
        <h1 id="hero-h" class="hero2__h" data-split="lines" data-intro>{hero.h1}</h1>
        <p class="lead hero2__lead" data-reveal="up" data-intro data-delay="0.2">{hero.lead}</p>
        <div class="hero2__cta" data-reveal="up" data-intro data-delay="0.32">
          <Btn href={hero.primary.href}>{hero.primary.label}</Btn>
          <a class="hero2__more draw" href={hero.secondary.href}>{hero.secondary.label}</a>
        </div>
        <ul class="hero2__trust" data-reveal="up" data-intro data-delay="0.42">
          {hero.trust.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <div class="hero2__stage" data-reveal="scale" data-intro data-delay="0.15">
        <div class="hero2__glow" aria-hidden="true"></div>
        <div class="hero2__laptop">
          <Shot name="pulpit-pc" frame="laptop" alt="Pulpit właściciela szkoły z grafikiem tygodnia, zdawalnością i listą kursantów" eager />
        </div>
        <div class="hero2__phone">
          <Shot name="start-tel" frame="phone" alt="Ekran startowy kursanta z najbliższą jazdą i postępem godzin" eager />
        </div>
      </div>
    </div>
  </section>

  <section class="funkcje" id="jak-to-dziala" aria-labelledby="funkcje-h">
    <div class="wrap">
      <header class="sec__head">
        <p class="eyebrow" data-reveal="fade">{chapters.label}</p>
        <h2 id="funkcje-h" class="h-xl" data-split="lines">{chapters.h2}</h2>
      </header>
      <ol class="funkcje__lista">
        {chapters.items.map((it, i) => (
          <li class:list={['funkcja', { 'funkcja--odwr': i % 2 === 1 }]}>
            <div class="funkcja__tekst" data-reveal="up">
              <p class="funkcja__kicker">{String(i + 1).padStart(2, '0')} — {it.kicker}</p>
              <h3 class="h-l">{it.title}</h3>
              <p>{it.text}</p>
            </div>
            <div class="funkcja__media" data-reveal="up" data-delay="0.08">
              <Shot name={it.shot} alt={it.alt} frame={it.frame as any} />
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="role-sec" id="role" aria-labelledby="role-h">
    <div class="wrap">
      <header class="sec__head">
        <p class="eyebrow" data-reveal="fade">{roles.label}</p>
        <h2 id="role-h" class="h-xl" data-split="lines">{roles.h2}</h2>
      </header>
      <div class="role" data-role>
        <div class="role__tabs" role="tablist" aria-label="Role w kursant24">
          {roles.items.map((r, i) => (
            <button
              type="button"
              class="role__tab"
              role="tab"
              id={`tab-${r.id}`}
              aria-controls={`panel-${r.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-role-tab
            >
              {r.label}
            </button>
          ))}
        </div>
        <div class="role__stage">
          {roles.items.map((r, i) => (
            <div
              class="role__panel"
              role="tabpanel"
              id={`panel-${r.id}`}
              aria-labelledby={`tab-${r.id}`}
              data-role-panel
              hidden={i !== 0}
            >
              <div class="role__tekst" data-reveal="up">
                <h3 class="h-l">{r.title}</h3>
                <p>{r.text}</p>
              </div>
              <div class="role__media">
                <Shot name={r.shot} alt={r.alt} frame={r.frame as any} />
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="roznice" id="wyrozniki" aria-labelledby="roznice-h">
    <div class="wrap">
      <header class="sec__head">
        <p class="eyebrow" data-reveal="fade">{index.label}</p>
        <h2 id="roznice-h" class="h-xl" data-split="lines">{index.h2}</h2>
      </header>
      <ul class="bento">
        {index.rows.map((r, i) => (
          <li class="bento__card" data-reveal="up" data-delay={String((i % 3) * 0.08)}>
            <a href={r.href}>
              <span class="bento__thumb" aria-hidden="true">
                <img src={bento[i].url} alt="" width="480" height="300" loading="lazy" decoding="async" />
              </span>
              <span class="bento__tytul">{r.title}</span>
              <span class="bento__nota">{r.note}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="kod-sec" aria-labelledby="kod-h">
    <div class="wrap">
      <p class="eyebrow" data-reveal="fade">{kod.label}</p>
      <Kod code={kod.code} />
      <div class="kod-sec__grid">
        <div>
          <h2 id="kod-h" class="h-l" data-split="lines">{kod.h2}</h2>
          <ol class="kroki">
            {kod.steps.map((s) => (
              <li class="krok" data-reveal="up">
                <span class="krok__n" aria-hidden="true">{s.n}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))}
          </ol>
          <p class="kod-sec__link"><a class="link" href="/dla-kursantow/">Jak to wygląda u kursanta</a></p>
        </div>
        <div class="kod-sec__shot" data-reveal="up">
          <Shot name={kod.shot} alt={kod.alt} />
        </div>
      </div>
    </div>
  </section>

  <Cennik id="cennik" />

  <MapaOSK label={map.label} h2={map.h2} text={map.text} attribution={map.attribution} />

  <Faq id="pytania" label="Pytania" h2="Zanim zapytasz" items={faqHome} />
</Base>
