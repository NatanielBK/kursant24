---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import { notFound as p } from '../data/content';
---
<Base title={p.title} description={p.text}>
  <section class="notfound" aria-labelledby="nf-h">
    <div class="wrap">
      <p class="eyebrow">Błąd 404</p>
      <h1 id="nf-h" class="h-xl">{p.h1}</h1>
      <p class="lead" style="margin-inline:auto">{p.text}</p>
      <div class="btn-row">
        <Btn href="/">Strona główna</Btn>
        <a class="link" href="/dla-szkol/">Dla szkół jazdy</a>
      </div>
    </div>
  </section>
</Base>
