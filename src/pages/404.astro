---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import { notFound as p } from '../data/content';
---
<Base title={p.title} description={p.text}>
  <section class="hero notfound-hero" aria-labelledby="nf-h">
    <div class="wrap">
      <div class="notfound__copy">
        <p class="eyebrow enter">Błąd 404</p>
        <h1 id="nf-h" class="h-xl enter enter--delay">{p.h1}</h1>
        <p class="lead enter enter--delay" style="margin-inline:auto">{p.text}</p>
        <div class="road-line enter enter--delay" aria-hidden="true">
          <i></i><i></i><i></i>
          <svg viewBox="0 0 12 12" width="12" height="12" fill="none"><path d="M2 2l6 4-6 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="btn-row enter enter--delay">
          <Btn href="/">Strona główna</Btn>
          <a class="link" href="/dla-szkol/">Dla szkół jazdy</a>
          <a class="link" href="/dla-kursantow/">Dla kursantów</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound-hero {
    min-height: auto;
    padding-block: clamp(3rem, 2.2rem + 4vw, 6rem);
    text-align: center;
  }
  .notfound__copy { max-width: 34rem; margin-inline: auto; }
  .notfound-hero .btn-row { justify-content: center; margin-top: 1.5rem; }

  /* Drobny akcent "drogi" — przerywana linia z grotem, w przepływie, bez nakładania na treść */
  .road-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: fit-content;
    margin: 1.6rem auto 0;
    color: var(--c-accent-bright);
  }
  .road-line i {
    width: 20px;
    height: 3px;
    border-radius: 2px;
    background: currentColor;
    opacity: 0.55;
  }
  .road-line i:last-of-type { opacity: 0.9; }
</style>
