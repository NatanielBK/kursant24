---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import Faq from '../components/Faq.astro';
import { cennik as p } from '../data/cennik';
---
<Base title={p.title} description={p.description}>
  <section class="hero" aria-labelledby="cennik-h">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow enter">{p.eyebrow}</p>
        <h1 id="cennik-h" class="h-xl enter enter--delay">{p.h1}</h1>
        <p class="lead enter enter--delay">{p.lead}</p>
        <div class="btn-row enter enter--delay">
          <Btn href="/pilotaz/">Umów prezentację</Btn>
          <Btn href="#wycena" variant="ghost">Poproś o wycenę</Btn>
        </div>
        <a class="link cennik-faq-link enter enter--delay" href="#pytania-h">Zobacz najczęstsze pytania</a>
      </div>
      <div class="price-card enter enter--delay">
        <p class="price-card__title">Co dostajesz w cenie</p>
        <ul class="price-card__list">
          {p.included.items.map((it) => (
            <li>
              <span class="price-card__icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10l4 4 8-8" /></svg>
              </span>
              {it.title}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="czynniki-h">
    <div class="wrap">
      <header class="section__head">
        <p class="eyebrow">{p.factors.eyebrow}</p>
        <h2 id="czynniki-h" class="h-l">{p.factors.h2}</h2>
      </header>
      <ul class="factors-scroll">
        {p.factors.items.map((f) => (
          <li class="factors-card">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </li>
        ))}
      </ul>
      <p class="factors-note">{p.factors.note}</p>
    </div>
  </section>

  <section class="section section--bg" aria-labelledby="przebieg-h">
    <div class="wrap">
      <header class="section__head">
        <p class="eyebrow">{p.process.eyebrow}</p>
        <h2 id="przebieg-h" class="h-l">{p.process.h2}</h2>
      </header>
      <ol class="steps-list">
        {p.process.steps.map((s) => (
          <li class="step-item">
            <span class="step-item__n" aria-hidden="true">{s.n}</span>
            <div><h3>{s.title}</h3><p>{s.text}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="wycena" aria-labelledby="wycena-h">
    <div class="wrap" style="max-width:40rem">
      <header class="section__head">
        <h2 id="wycena-h" class="h-l">{p.form.h2}</h2>
        <p class="lead">{p.form.text}</p>
      </header>
      <form class="form-card" data-cennik novalidate>
        <div class="field">
          <label for="f-szkola">Nazwa szkoły</label>
          <input id="f-szkola" name="szkola" autocomplete="organization" required />
        </div>
        <div class="field">
          <label for="f-miasto">Miasto</label>
          <input id="f-miasto" name="miasto" autocomplete="address-level2" required />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="f-instruktorzy">Liczba instruktorów</label>
            <input id="f-instruktorzy" name="instruktorzy" type="number" min="1" inputmode="numeric" required />
          </div>
          <div class="field">
            <label for="f-kursanci">Kursantów w miesiącu</label>
            <input id="f-kursanci" name="kursanci" type="number" min="1" inputmode="numeric" required />
          </div>
        </div>
        <div class="field">
          <label for="f-oddzialy">Liczba oddziałów/lokalizacji</label>
          <input id="f-oddzialy" name="oddzialy" type="number" min="1" inputmode="numeric" />
        </div>
        <fieldset class="field">
          <legend>Kategorie prawa jazdy</legend>
          <div class="cat-grid">
            {p.form.categories.map((c) => (
              <label class="cat-item">
                <input type="checkbox" name="kategorie" value={c} />
                <span>{c}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="field-row">
          <div class="field">
            <label for="f-tel">Telefon</label>
            <input id="f-tel" name="telefon" type="tel" autocomplete="tel" inputmode="tel" />
          </div>
          <div class="field">
            <label for="f-mail">E-mail</label>
            <input id="f-mail" name="email" type="email" autocomplete="email" required />
          </div>
        </div>
        <div class="field">
          <label for="f-uwagi">Uwagi</label>
          <textarea id="f-uwagi" name="uwagi" rows="3"></textarea>
        </div>
        <Btn type="submit">{p.form.submit}</Btn>
      </form>
    </div>
  </section>

  <Faq id="pytania" eyebrow="Pytania" h2="Co jeszcze warto wiedzieć" items={p.faq} />

  <section class="cta-band" aria-labelledby="cta-h">
    <div class="wrap cta-band__inner">
      <h2 id="cta-h" class="h-l">{p.cta.h2}</h2>
      <p>{p.cta.text}</p>
      <div class="btn-row">
        <Btn href="#wycena" variant="light">Poproś o wycenę</Btn>
        <a class="link" href="/pilotaz/">albo umów prezentację</a>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/cennik-form';
  </script>
</Base>

<style>
  /* Karta "co dostajesz w cenie" w ciemnym hero — bez kwot, tylko lista. */
  .price-card {
    padding: 1.5rem 1.6rem;
    border-radius: var(--radius-l);
    background: color-mix(in srgb, var(--c-ink-deep-3) 70%, transparent);
    backdrop-filter: blur(14px);
    border: 1px solid var(--c-line-deep-strong);
  }
  .price-card__title {
    font-size: var(--t-xs); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--c-on-deep); margin-bottom: 1rem;
  }
  .price-card__list { display: flex; flex-direction: column; gap: 0.75rem; }
  .price-card__list li { display: flex; align-items: center; gap: 0.75rem; font-weight: 600; font-size: var(--t-s); color: #fff; }
  .price-card__icon {
    flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
    width: 1.6rem; height: 1.6rem; border-radius: 50%;
    background: color-mix(in srgb, var(--c-accent-bright) 25%, transparent); color: var(--c-accent-bright);
  }
  .price-card__icon svg { width: 13px; height: 13px; }

  /* Drugi przycisk w ciemnym hero: obrysowany, jasny tekst i obwódka zamiast ciemnych z .btn--ghost.
     :global, bo <Btn> renderuje <a> we własnym komponencie, poza zasięgiem scoped stylów tej strony. */
  :global(.hero .btn--ghost) { color: #fff; border-color: var(--c-line-deep-strong); }
  :global(.hero .btn--ghost:hover) { color: var(--c-accent-bright); border-color: var(--c-accent-bright); }

  .cennik-faq-link { display: inline-block; margin-top: 1rem; color: var(--c-on-deep-strong); }

  @media (min-width: 900px) {
    .hero .wrap.hero__grid { align-items: start; padding-block: 2rem; }
  }

  /* Odstęp nagłówek → opis tam, gdzie oba siedzą bezpośrednio w .section__head */
  .section__head .lead { margin-top: 0.6rem; }

  /* Fieldset kategorii — bez ramki przeglądarki, legenda jak etykieta pola */
  fieldset.field { border: 0; padding: 0; min-width: 0; }
  fieldset.field legend { padding: 0; font-size: var(--t-xs); font-weight: 600; color: var(--c-muted); }

  /* Pola formularza wygodne w dotyku. */
  .form-card .field input,
  .form-card .field select,
  .form-card .field textarea { min-height: 44px; }

  /* Karuzela "od czego zależy cena": na telefonie pozioma, scroll-snap, z wystającą kolejną kartą.
     Od 640px wraca do zwykłego gridu bez przewijania. */
  .factors-scroll {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-bottom: 0.4rem;
    scrollbar-width: none;
  }
  .factors-scroll::-webkit-scrollbar { display: none; }
  .factors-card {
    flex: 0 0 82%;
    scroll-snap-align: start;
    background: var(--c-bg-2);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    padding: 1.25rem 1.4rem;
  }
  .factors-card h3 { font-size: var(--t-s); margin-bottom: 0.4rem; }
  .factors-card p { font-size: var(--t-xs); color: var(--c-muted); line-height: 1.45; }
  .factors-note { margin-top: 1.5rem; font-size: var(--t-s); color: var(--c-muted); max-width: 40rem; }

  @media (min-width: 640px) {
    .factors-scroll {
      overflow-x: visible;
      flex-wrap: wrap;
      margin-inline: 0;
      padding-inline: 0;
    }
    .factors-card { flex: 0 0 calc(50% - 0.5rem); }
  }
  @media (min-width: 900px) {
    .factors-card { flex-basis: calc(33.333% - 0.84rem); padding: 1.5rem; }
    .factors-card h3 { font-size: var(--t-body); }
    .factors-card p { font-size: var(--t-s); }
  }
</style>
