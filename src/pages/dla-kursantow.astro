---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import Shot from '../components/Shot.astro';
import Faq from '../components/Faq.astro';
import { dlaKursantow as p } from '../data/content';
import { shots } from '../data/zrzuty';

const heroShot = await getImage({ src: shots[p.shot.name], format: 'webp', quality: 82, width: 390 });
---
<Base title={p.title} description={p.description}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroShot.src} fetchpriority="high" />
  </Fragment>

  <section class="podhero" aria-labelledby="podhero-h">
    <div class="wrap podhero__grid">
      <div class="podhero__copy">
        <p class="eyebrow">{p.eyebrow}</p>
        <h1 id="podhero-h" class="h-xl">{p.h1}</h1>
        <p class="lead">{p.lead}</p>
        <div class="btn-row">
          <Btn href="/pilotaz/">Umów prezentację</Btn>
          <a class="link" href="#kroki">Jak zacząć</a>
        </div>
      </div>
      <div class="podhero__shot">
        <Shot name={p.shot.name} alt={p.shot.alt} eager />
      </div>
    </div>
  </section>

  <section class="section section--bg" id="kroki" aria-labelledby="kroki-h">
    <div class="wrap">
      <header class="section__head">
        <p class="eyebrow">Jak zacząć</p>
        <h2 id="kroki-h" class="h-l">Trzy kroki, zero zakładania konta</h2>
      </header>
      <div class="split">
        <ol class="steps-list">
          {p.steps.map((s) => (
            <li class="step-item">
              <span class="step-item__n" aria-hidden="true">{s.n}</span>
              <div><h3>{s.title}</h3><p>{s.text}</p></div>
            </li>
          ))}
        </ol>
        <div class="split__shot">
          <Shot name="dostep-tel" alt="Kod aktywacyjny i hasło startowe, które kursant dostaje od szkoły." frame="phone" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="widzisz-h">
    <div class="wrap">
      <header class="section__head">
        <p class="eyebrow">Co widzisz w aplikacji</p>
        <h2 id="widzisz-h" class="h-l">Wszystko o Twoim kursie, w jednym miejscu</h2>
      </header>
      <div class="see-grid">
        {p.see.map((s) => (
          <article class="see-card">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Faq id="pytania" eyebrow="Pytania kursantów" h2="Gdy coś nie działa" items={p.faq} />

  <section class="cta-band" aria-labelledby="ctaband-h">
    <div class="wrap cta-band__inner">
      <p class="eyebrow eyebrow--light">Twojej szkoły tu nie ma?</p>
      <h2 id="ctaband-h" class="h-l">Pokaż ją swojej szkole.</h2>
      <p>kursant24 włącza szkoła jazdy. Wyślij właścicielowi link do strony dla szkół.</p>
      <div class="btn-row">
        <Btn href="/dla-szkol/" variant="light">Strona dla szkół jazdy</Btn>
      </div>
    </div>
  </section>
</Base>
