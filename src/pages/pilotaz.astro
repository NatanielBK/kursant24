---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import { site, credits } from '../data/content';
import { pilotaz as p } from '../data/pilotaz';
---
<Base title={p.title} description={p.description}>
  <section class="hero" aria-labelledby="pilotaz-h">
    <div class="wrap pilotaz__grid">
      <div class="pilotaz__copy">
        <p class="eyebrow enter">{p.eyebrow}</p>
        <h1 id="pilotaz-h" class="h-xl enter enter--delay">{p.h1}</h1>
        <p class="lead enter enter--delay">{p.lead}</p>
        <ul class="pilotaz__promises enter enter--delay">
          {p.promises.map((o) => <li>{o}</li>)}
        </ul>
        <p class="enter enter--delay">Wolisz e-mail? <a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>

        <div class="credits-card enter enter--delay">
          <p class="credits-card__org">Kontakt bezpośredni — {credits.org}</p>
          <ul class="credits-card__list">
            {credits.items.map((c) => (
              <li>
                <span class="credits-card__name">{c.name}</span>
                <span class="credits-card__links">
                  <a class="link" href={`tel:+48${c.phone.replace(/\s/g, '')}`}>{c.phone}</a>
                  <a class="link" href={`mailto:${c.email}`}>{c.email}</a>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="form-card enter enter--delay">
        <form data-pilotaz novalidate>
          <p class="form-demo-note" role="note">{p.demoNote}</p>
          <div class="field">
            <label for="f-szkola">Nazwa szkoły</label>
            <input id="f-szkola" name="szkola" autocomplete="organization" required />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="f-miasto">Miasto</label>
              <input id="f-miasto" name="miasto" autocomplete="address-level2" required />
            </div>
            <div class="field">
              <label for="f-kursanci">Kursantów w roku</label>
              <select id="f-kursanci" name="kursanci">
                {p.sizes.map((s) => <option>{s}</option>)}
              </select>
            </div>
          </div>
          <div class="field">
            <label for="f-osoba">Imię i nazwisko</label>
            <input id="f-osoba" name="osoba" autocomplete="name" required />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="f-tel">Telefon</label>
              <input id="f-tel" name="telefon" type="tel" autocomplete="tel" inputmode="tel" required />
            </div>
            <div class="field">
              <label for="f-mail">E-mail</label>
              <input id="f-mail" name="email" type="email" autocomplete="email" required />
            </div>
          </div>
          <label class="consent">
            <input type="checkbox" name="zgoda" required />
            <span>{p.consent}</span>
          </label>
          <p class="form-error" data-blad role="alert" hidden>Uzupełnij zaznaczone pola.</p>
          <Btn type="submit">Wyślij zgłoszenie</Btn>
        </form>

        <div class="done" data-gotowe hidden tabindex="-1">
          <p class="eyebrow">Wersja demonstracyjna</p>
          <h2 class="h-l">{p.done.h2}</h2>
          <dl data-podsumowanie></dl>
          <p>{p.done.text}</p>
          <p>Wolisz, żebyśmy napisali pierwsi? <a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="po-h">
    <div class="wrap">
      <header class="section__head">
        <p class="eyebrow">{p.after.eyebrow}</p>
        <h2 id="po-h" class="h-l">{p.after.h2}</h2>
      </header>
      <ol class="steps-list">
        {p.after.steps.map((s) => (
          <li class="step-item">
            <span class="step-item__n" aria-hidden="true">{s.n}</span>
            <div><h3>{s.title}</h3><p>{s.text}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <script>
    import '../scripts/pilotaz-form';
  </script>
</Base>

<style>
  .credits-card {
    margin-top: 1.5rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--c-ink-deep-3) 70%, transparent);
    backdrop-filter: blur(14px);
    border: 1px solid var(--c-line-deep-strong);
  }
  .credits-card__org {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-on-deep);
    margin-bottom: 0.7rem;
  }
  .credits-card__list { display: flex; flex-direction: column; gap: 0.7rem; }
  .credits-card__list li + li { padding-top: 0.7rem; border-top: 1px solid var(--c-line-deep); }
  .credits-card__name { display: block; font-weight: 700; font-size: var(--t-s); color: #fff; margin-bottom: 0.15rem; }
  .credits-card__links { display: flex; flex-wrap: wrap; gap: 0.3rem 0.8rem; font-size: var(--t-xs); }
  .credits-card__links .link { color: var(--c-on-deep-strong); }
  @media (min-width: 900px) {
    .hero { align-items: stretch; }
    .hero .wrap.pilotaz__grid { align-items: start; padding-block: 2rem; }
  }
</style>
