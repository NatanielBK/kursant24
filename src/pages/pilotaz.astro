---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import { pilotaz as p, site, credits } from '../data/content';
---
<Base title={p.title} description={p.description}>
  <section class="section" aria-labelledby="pilotaz-h">
    <div class="wrap pilotaz__grid">
      <div>
        <p class="eyebrow">{p.eyebrow}</p>
        <h1 id="pilotaz-h" class="h-xl">{p.h1}</h1>
        <p class="lead">{p.lead}</p>
        <ul class="pilotaz__promises">
          {p.promises.map((o) => <li>{o}</li>)}
        </ul>
        <p>Wolisz e-mail? <a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
        <div class="pilotaz__contacts">
          <p class="eyebrow">Kontakt bezpośredni — {credits.org}</p>
          <ul>
            {credits.items.map((c) => (
              <li>
                <strong>{c.name}</strong>: tel.{' '}
                <a class="link" href={`tel:+48${c.phone.replace(/\s/g, '')}`}>{c.phone}</a>,{' '}
                <a class="link" href={`mailto:${c.email}`}>{c.email}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="form-card">
        <form data-pilotaz novalidate>
          <p class="form-demo-note" role="note">{p.demoNote}</p>
          <div class="field">
            <label for="f-szkola">Nazwa szkoły</label>
            <input id="f-szkola" name="szkola" autocomplete="organization" required />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="f-miasto">Miasto</label>
              <input id="f-miasto" name="miasto" autocomplete="address-level2" required />
            </div>
            <div class="field">
              <label for="f-kursanci">Kursantów w roku</label>
              <select id="f-kursanci" name="kursanci">
                {p.sizes.map((s) => <option>{s}</option>)}
              </select>
            </div>
          </div>
          <div class="field">
            <label for="f-osoba">Imię i nazwisko</label>
            <input id="f-osoba" name="osoba" autocomplete="name" required />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="f-tel">Telefon</label>
              <input id="f-tel" name="telefon" type="tel" autocomplete="tel" inputmode="tel" required />
            </div>
            <div class="field">
              <label for="f-mail">E-mail</label>
              <input id="f-mail" name="email" type="email" autocomplete="email" required />
            </div>
          </div>
          <label class="consent">
            <input type="checkbox" name="zgoda" required />
            <span>{p.consent}</span>
          </label>
          <p class="form-error" data-blad role="alert" hidden>Uzupełnij zaznaczone pola.</p>
          <Btn type="submit">Wyślij zgłoszenie</Btn>
        </form>

        <div class="done" data-gotowe hidden tabindex="-1">
          <p class="eyebrow">Wersja demonstracyjna</p>
          <h2 class="h-l">{p.done.h2}</h2>
          <dl data-podsumowanie></dl>
          <p>{p.done.text}</p>
          <p>Wolisz, żebyśmy napisali pierwsi? <a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
      </div>
    </div>
  </section>
  <script>
    import '../scripts/pilotaz-form';
  </script>
</Base>
